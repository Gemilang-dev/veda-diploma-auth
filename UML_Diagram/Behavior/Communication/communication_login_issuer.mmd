graph TD
    Issuer((University Admin))
    FE[React Frontend]
    Google[Google OAuth]
    BE[FastAPI Backend]
    DB[(MySQL Database)]

    %% Method 1: Form
    Issuer -- "1.1: Enter Email/Pass" --> FE
    FE -- "1.2: POST /api/issuer/login" --> BE
    BE -- "1.3: Query & Verify Status" --> DB
    DB -- "1.4: Issuer Data" --> BE
    BE -- "1.5: Return JWT" --> FE

    %% Method 2: Google
    Issuer -- "2.1: Click Google Login" --> FE
    FE -- "2.2: Authenticate" --> Google
    Google -- "2.3: ID Token" --> FE
    FE -- "2.4: POST /api/auth/google-login" --> BE
    BE -- "2.5: Verify Token" --> Google
    BE -- "2.6: Check Email & Status" --> DB
    BE -- "2.7: Return JWT" --> FE

    FE -- "3: Store Token & Redirect" --> FE
